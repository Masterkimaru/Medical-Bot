# ==========================================================================
# MediBot environment variables - copy to .env and fill in real values.
# NEVER commit real credentials to source control.
# ==========================================================================

# ---- Pinecone (required) ----
PINECONE_API_KEY=your-pinecone-api-key

# Index used when EMBEDDING_PROVIDER=openrouter (nvidia/nemotron-3-embed-1b:free, 2048-dim).
# This is a NEW index - the legacy 384-dim "doctorbot" index is never modified.
PINECONE_INDEX_OPENROUTER=doctorbot-nemotron-2048

# Index used for the local MiniLM fallback (384-dim).
PINECONE_INDEX_LOCAL=doctorbot-minilm-384

# ---- Embedding provider ----
# "openrouter" (default) or "local"
EMBEDDING_PROVIDER=openrouter

# OpenRouter embedding model
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Optional OpenRouter attribution headers
SITE_URL=https://your-site-url.com
SITE_NAME=MediBot

# ---- OpenRouter LLM (required for OpenRouter-hosted agents) ----
OPENROUTER_API_KEY=your-openrouter-api-key
# Primary medical/general chat model
MEDICAL_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Mental-health chat model
MENTAL_HEALTH_LLM_MODEL=ainclusionai/ling-3.0-flash:free
# Vision model used by /analyze-image
VISION_LLM_MODEL=nvidia/nemotron-3.5-content-safety:free

# ---- Groq (optional secondary provider for failover) ----
GROQ_API_KEY=your-groq-api-key
MEDICAL_FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
MENTAL_HEALTH_FALLBACK_LLM_MODEL=llama-3.3-70b-versatile

# ---- MongoDB (required - on-site professional lookup) ----
MONGODB_URI=your-mongodb-connection-string
MONGODB_DB_NAME=medi_bot

# ---- Behaviour toggles ----
# "true" enables LLM-based response validation (adds latency/cost); rule-based checks always run.
VALIDATION_ENABLED=false
# Render sets PORT automatically.
PORT=5000
